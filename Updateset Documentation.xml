<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;global.DocumentUtils&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;true&lt;/client_callable&gt;&lt;description&gt;Generates a Word document for an Update Set: one numbered development point per captured record, each followed by a snapshot of that record.&lt;/description&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;DocumentUtils&lt;/name&gt;&lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var DocumentUtils = Class.create();
DocumentUtils.prototype = Object.extendsObject(AbstractAjaxProcessor, {

    getDoc: function() {
        var updateSetSysId = this.getParameter('sysparm_updatesetSysId');

        if (!updateSetSysId) {
            return JSON.stringify({
                status: 'error',
                message: 'Update Set sys_id not received.'
            });
        }

        return this.backendLogic(updateSetSysId);
    },

    backendLogic: function(updateSetSysId) {

        var updateSet = new GlideRecord('sys_update_set');

        if (!updateSet.get(updateSetSysId)) {
            return JSON.stringify({
                status: 'error',
                message: 'Update Set not found.'
            });
        }

        var instanceUrl = gs.getProperty('glide.servlet.uri');
        var updateSetLink = instanceUrl + 'sys_update_set.do?sys_id=' + updateSetSysId;

        var updates = [];

        var updateXML = new GlideRecord('sys_update_xml');
        updateXML.addQuery('update_set', updateSetSysId);
        updateXML.addQuery('action', 'IN', 'INSERT_OR_UPDATE,DELETE');
        updateXML.orderBy('sys_updated_on');
        updateXML.query();

        while (updateXML.next()) {

            var updateName = updateXML.name.toString();

            var tableName = '';
            var recordSysId = '';

            var match = updateName.match(/^(.+)_([0-9a-f]{32})$/);

            // sys_script_include_e55c94e6c3fbc71476cbbecdd401313c
            if (match) {
                tableName = match[1];
                recordSysId = match[2];
            }

            var targetName = updateXML.target_name.toString() || updateName;
            var payload = updateXML.payload.toString();
            var action = updateXML.action.toString();

            var type = this.getReadableType(tableName, updateXML);
            var readableAction = this.decideCreatedUpdatedDeleted(action, tableName, recordSysId, updateSetSysId, updateXML);

            var recordLink = '';

            if (tableName &amp;&amp; recordSysId &amp;&amp; readableAction != 'Deleted') {
                recordLink = instanceUrl + tableName + '.do?sys_id=' + recordSysId;
            }

            var viewValue = '';

            if (updateXML.isValidField('view')) {
                viewValue = updateXML.view.getDisplayValue();
            }

            var recordDescription = this.getRecordDescription(tableName, recordSysId, payload);
            var explanation = this.getSimpleExplanation(
                readableAction,
                type,
                targetName,
                recordDescription
            );

            updates.push({
                action: readableAction,
                type: type,
                tableName: tableName,
                targetName: targetName,
                recordLink: recordLink,
                view: viewValue,
                explanation: explanation,
            });
        }

        var html = '';

        html += '&lt;html&gt;';
        html += '&lt;head&gt;';
        html += '&lt;meta charset="UTF-8"&gt;';
        html += '&lt;style&gt;';

        html += 'body {';
        html += 'font-family: Calibri, Arial, sans-serif;';
        html += 'font-size: 11pt;';
        html += 'color: #1f1f1f;';
        html += 'line-height: 1.4;';
        html += 'margin: 36px;';
        html += '}';

        html += 'h1 {';
        html += 'font-size: 20pt;';
		html += 'text-align: center;';
        html += 'color:#0b3b8c;';
        html += 'font-weight: bold;';
        html += 'margin-top: 0;';
        html += 'margin-bottom: 6px;';
        html += '}';

        html += 'h2 {';
        html += 'font-size: 13.5pt;';
		html += 'text-align: center;';
        html += 'color: #000000;';
        html += 'font-weight: bold;';
        html += 'margin-top: 24px;';
        html += 'margin-bottom: 10px;';
        html += 'border-bottom: 1px solid #bfbfbf;';
        html += 'padding-bottom: 4px;';
        html += '}';

        html += 'h3 {';
        html += 'font-size: 12pt;';
        html += 'color: #000000;';
        html += 'font-weight: bold;';
        html += 'margin-top: 16px;';
        html += 'margin-bottom: 6px;';
        html += '}';

        html += 'p {';
        html += 'margin-top: 4px;';
        html += 'margin-bottom: 6px;';
        html += '}';

        html += 'div {';
        html += 'margin: 0;';
        html += 'padding: 0;';
        html += '}';

        html += '.subtle {';
        html += 'color: #666666;';
        html += 'font-size: 9.5pt;';
        html += 'margin-bottom: 18px;';
        html += '}';

        html += '.summary-box {';
        html += 'background: none;';
        html += 'border: none;';
        html += 'padding: 0;';
        html += 'margin-top: 8px;';
        html += 'margin-bottom: 18px;';
        html += '}';

        html += '.field {';
        html += 'margin-top: 5px;';
        html += 'margin-bottom: 5px;';
        html += '}';

        html += '.label {';
        html += 'font-weight: bold;';
        html += 'color: #000000;';
        html += '}';

        html += '.change-card {';
        html += 'background: none;';
        html += 'border: none;';
        html += 'padding: 0;';
        html += 'margin-top: 18px;';
        html += 'margin-bottom: 22px;';
        html += '}';

        html += '.explanation {';
        html += 'background: none;';
        html += 'border: none;';
        html += 'padding: 0;';
        html += 'margin-top: 8px;';
        html += 'margin-bottom: 8px;';
        html += '}';

        html += 'a {';
        html += 'color: #055bb0;';
        html += 'text-decoration: underline;';
        html += '}';

        html += '&lt;/style&gt;';
        html += '&lt;/head&gt;';

        html += '&lt;body&gt;';

        html += '&lt;h1&gt;' + this.escapeHtml(updateSet.name.toString()) + '&lt;/h1&gt;';
        html += '&lt;div class="subtle"&gt;Generated on ' + this.escapeHtml(new GlideDateTime().getDisplayValue()) + '&lt;/div&gt;';

        html += '&lt;h2&gt;Update Set Information&lt;/h2&gt;';
        html += '&lt;div class="summary-box"&gt;';

        html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Update Set Name:&lt;/span&gt; ';
        html += this.escapeHtml(updateSet.name.toString()) + '&lt;/div&gt;';

        html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Description:&lt;/span&gt;&lt;br/&gt;';
        html += this.textToHtml(updateSet.description.toString()) + '&lt;/div&gt;';

        html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Update Set Link:&lt;/span&gt; ';
        html += '&lt;a href="' + this.escapeHtml(updateSetLink) + '"&gt;' + this.escapeHtml(updateSetLink) + '&lt;/a&gt;&lt;/div&gt;';

        html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Application:&lt;/span&gt; ';
        html += this.escapeHtml(updateSet.application.getDisplayValue()) + '&lt;/div&gt;';

        html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Created On:&lt;/span&gt; ';
        html += this.escapeHtml(updateSet.sys_created_on.getDisplayValue()) + '&lt;/div&gt;';

        html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Created By:&lt;/span&gt; ';
        html += this.escapeHtml(updateSet.sys_created_by.toString()) + '&lt;/div&gt;';

        html += '&lt;/div&gt;';
		html += '&lt;/br&gt;';

        html += '&lt;h2&gt;Development Changes&lt;/h2&gt;';

        if (updates.length == 0) {
            html += '&lt;p&gt;No captured updates found in this Update Set.&lt;/p&gt;';
        } else {
            for (var i = 0; i &lt; updates.length; i++) {
                var item = updates[i];

                html += '&lt;div class="change-card"&gt;';

                html += '&lt;h3&gt;' + (i + 1) + '. ' + this.escapeHtml(item.targetName) + '&lt;/h3&gt;';

                html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Action:&lt;/span&gt; ';
                html += this.escapeHtml(item.action) + '&lt;/div&gt;';

                html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Type:&lt;/span&gt; ';
                html += this.escapeHtml(item.type) + '&lt;/div&gt;';

                html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Target Name:&lt;/span&gt; ';
                html += this.escapeHtml(item.targetName) + '&lt;/div&gt;';

                html += '&lt;div class="explanation"&gt;';
                html += '&lt;span class="label"&gt;Explanation:&lt;/span&gt;&lt;br/&gt;';
                html += this.textToHtml(item.explanation);
                html += '&lt;/div&gt;';

                if (item.recordLink) {
                    html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Record Link:&lt;/span&gt; ';
                    html += '&lt;a href="' + this.escapeHtml(item.recordLink) + '"&gt;Open Record&lt;/a&gt;';
                    html += '&lt;br/&gt;&lt;span class="subtle"&gt;' + this.escapeHtml(item.recordLink) + '&lt;/span&gt;&lt;/div&gt;';
                } else {
                    html += '&lt;div class="field"&gt;&lt;span class="label"&gt;Record Link:&lt;/span&gt; Not available';
                    if (item.action == 'Deleted') {
                        html += ' because this record was deleted.';
                    }
                    html += '&lt;/div&gt;';
                }

                if (item.view) {
                    html += '&lt;div class="field"&gt;&lt;span class="label"&gt;View:&lt;/span&gt; ';
                    html += this.escapeHtml(item.view) + '&lt;/div&gt;';
                }

                html += '&lt;/div&gt;';
            }
        }

        html += '&lt;/body&gt;';
        html += '&lt;/html&gt;';

       var fileName = this.cleanFileName(updateSet.name.toString() + ' (Documentation)') + '.docx';

		var attachment = new GlideSysAttachment();

		var attachmentSysId = attachment.write(
			updateSet,
			fileName,
			'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
			html
		);

        if (!attachmentSysId) {
            return JSON.stringify({
                status: 'error',
                message: 'Document attachment could not be created.'
            });
        }

        var downloadLink = instanceUrl + 'sys_attachment.do?sys_id=' + attachmentSysId;

        return JSON.stringify({
            status: 'success',
            message: 'Document generated successfully.',
            attachment_sys_id: attachmentSysId,
            download_url: downloadLink
        });
    },

    decideCreatedUpdatedDeleted: function(action, tableName, recordSysId, updateSetSysId, updateXML) {

        if (action == 'DELETE') {
            return 'Deleted';
        }

        if (action != 'INSERT_OR_UPDATE') {
            return this.getReadableAction(action);
        }

        var updateName = '';

        if (updateXML) {
            updateName = updateXML.name.toString();
        }

        if (!updateName &amp;&amp; tableName &amp;&amp; recordSysId) {
            updateName = tableName + '_' + recordSysId;
        }

        if (!updateName) {
            return 'Created / Updated';
        }

        var version = new GlideRecord('sys_update_version');
        version.addQuery('name', updateName);
        version.orderBy('sys_created_on');
        version.query();

        while (version.next()) {

            var sourceSysId = '';

